---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import homepage from '../data/homepage.json';
import {
  SECTIONS, SITE, type Article, authorLabel, dayOf, formatDate, getArticles, getAuthorMap, href, permalink, picture, refId, sectionLabel,
} from '../lib/site';

// Front page = the newest edition, then a look back.
// An "edition" is a print issue once three of its articles are online; otherwise the most
// recent publication day.
const all = await getArticles();
const authorMap = await getAuthorMap();
const issues = await getCollection('issues');
const issueById = new Map(issues.map((i) => [i.id, i]));
const perIssue = new Map<string, number>();
for (const a of all) if (a.data.issueId) perIssue.set(a.data.issueId, (perIssue.get(a.data.issueId) ?? 0) + 1);

const first = all[0];
const firstIssue = first?.data.issueId && (perIssue.get(first.data.issueId) ?? 0) >= 3 ? issueById.get(first.data.issueId) : undefined;
const edition = !first ? [] : firstIssue
  ? all.filter((a) => a.data.issueId === firstIssue.id).sort((a, b) => (a.data.printOrder ?? 999) - (b.data.printOrder ?? 999))
  : all.filter((a) => dayOf(a.data.publishedAt) === dayOf(first.data.publishedAt));
const earlier = all.filter((a) => !edition.includes(a));

// Lead: the editors' pick, else a story marked "featured", else the first with a landscape photo.
const byId = new Map(all.map((a) => [a.id, a]));
const ratio = (a: Article) => { const p = picture(a.data.coverImage); return p?.width && p.height ? p.width / p.height : 0; };
const chosen = byId.get(refId(homepage.lead));
const lead = (chosen && edition.includes(chosen) ? chosen : undefined)
  ?? edition.find((a) => a.data.featured && a.data.coverImage)
  ?? edition.find((a) => ratio(a) >= 1.4)
  ?? edition.find((a) => a.data.coverImage)
  ?? edition[0];
const leadPic = lead ? picture(lead.data.coverImage) : null;
const editorial = edition.find((a) => a !== lead && a.data.kind === 'editorial');
const rest = edition.filter((a) => a !== lead && a !== editorial);
const trio = rest.slice(0, 3);
const rows = rest.slice(3);

const cover = firstIssue ? picture(firstIssue.data.pageImages[0]) : null;
const desks = SECTIONS.map((s) => ({ ...s, count: all.filter((a) => a.data.section === s.slug).length })).filter((s) => s.count > 0);

// Looking back: eight photo stories, then a column list of headlines.
const earlierPhotos = earlier.filter((a) => a.data.coverImage).slice(0, 8);
const earlierHeads = earlier.filter((a) => !earlierPhotos.includes(a)).slice(0, 15);
const shelf = issues.filter((i) => i.data.pageImages.length > 0).sort((a, b) => (b.data.publishedOn ?? `${b.data.year}`).localeCompare(a.data.publishedOn ?? `${a.data.year}`));
const editionLabel = firstIssue ? firstIssue.data.title : first ? formatDate(first.data.publishedAt) : '';
const byline = (a: Article) => a.data.authors.map((id) => authorMap.get(id)).filter((x) => x?.data.visible).map((x) => authorLabel(x!)).join(', ');
---
<BaseLayout>
  <h1 class="visually-hidden">{SITE.name}</h1>
  {!lead && <div class="wrap band"><p>No articles have been published yet.</p></div>}

  {lead && (
    <div class="wrap">
      <p class="issue-strip">
        <strong>{editionLabel}</strong>
        {firstIssue?.data.dateLabel && <span>{firstIssue.data.dateLabel}</span>}
        {firstIssue && <a href={href(`/issues/${firstIssue.id}/`)}>Read the print edition</a>}
      </p>

      <section class:list={['lead', { 'no-photo': !leadPic }]} aria-label="Lead story">
        {leadPic && (
          <figure class="lead-photo">
            <a href={href(permalink(lead))} tabindex="-1" aria-hidden="true">
              <img src={leadPic.src} srcset={leadPic.srcset} sizes="(min-width: 1024px) 700px, 100vw" width={leadPic.width} height={leadPic.height} alt="" fetchpriority="high" decoding="async" />
            </a>
            {(lead.data.coverCaption || lead.data.coverCredit) && <figcaption>{lead.data.coverCaption} {lead.data.coverCredit && <span class="credit">{lead.data.coverCredit}</span>}</figcaption>}
          </figure>
        )}
        <StoryCard article={lead} size="lead" image={false} heading="h2" dekLength={330} />
      </section>

      {trio.length > 0 && (
        <section class="trio" aria-label="Top stories">
          {trio.map((a) => <StoryCard article={a} size="medium" image={false} heading="h2" dekLength={260} />)}
        </section>
      )}

      <div class="issue-body">
        <section aria-labelledby="more-head">
          <div class="section-label"><h2 id="more-head">{firstIssue ? 'More from this issue' : 'More stories'}</h2></div>
          <div class="rows">
            {rows.map((a) => <StoryCard article={a} size="medium" layout="row" heading="h3" dekLength={240} sizes="(min-width: 700px) 190px, 110px" />)}
          </div>
        </section>

        <aside class="aside" aria-label="This issue">
          {firstIssue && cover && (
            <div class="print-card">
              <div class="section-label" style="margin-bottom:0"><h2>In print</h2></div>
              <a class="cover" href={href(`/issues/${firstIssue.id}/`)} tabindex="-1" aria-hidden="true">
                <img src={cover.src} srcset={cover.srcset} sizes="(min-width: 1024px) 380px, 260px" width={cover.width} height={cover.height} alt="" loading="lazy" decoding="async" />
              </a>
              <div>
                <h3>{firstIssue.data.title}</h3>
                <p>{firstIssue.data.dateLabel}{firstIssue.data.pageImages.length > 0 && ` · ${firstIssue.data.pageImages.length} pages`}</p>
              </div>
              <div class="actions">
                <a class="button" href={href(`/issues/${firstIssue.id}/`)}>Read page by page</a>
                {firstIssue.data.pdf && <a class="button ghost" href={href(firstIssue.data.pdf)}>PDF</a>}
              </div>
            </div>
          )}
          {editorial && (
            <div class="editorial-box">
              <StoryCard article={editorial} size="medium" image={false} heading="h3" dekLength={420} />
            </div>
          )}
          <nav aria-labelledby="desks-head">
            <div class="section-label" style="margin-bottom:.25rem"><h2 id="desks-head">Sections</h2></div>
            <ul class="desk-list">
              {desks.map((s) => <li><a href={href(`/${s.slug}/`)}>{s.label}<span class="count">{s.count}</span></a></li>)}
            </ul>
          </nav>
        </aside>
      </div>
    </div>
  )}

  {earlier.length > 0 && (
    <section class="archive" aria-labelledby="archive-head">
      <div class="wrap">
        <div class="archive-intro">
          <div>
            <span class="eyebrow">From the archive</span>
            <h2 id="archive-head">Earlier in <em>The Governor</em></h2>
          </div>
          <a class="more-link" href={href('/archives/')}>All {all.length} articles</a>
        </div>
        {earlierPhotos.length > 0 && (
          <div class="photo-grid uniform">
            {earlierPhotos.map((a) => <StoryCard article={a} size="small" heading="h3" dek={false} sizes="(min-width: 1024px) 290px, 50vw" />)}
          </div>
        )}
        {earlierHeads.length > 0 && (
          <ul class="headline-list">
            {earlierHeads.map((a) => (
              <li>
                <a href={href(permalink(a))}>{a.data.title}</a>
                <span class="meta"><span class="kicker">{a.data.kind === 'editorial' ? 'Editorial' : sectionLabel(a.data.section)}</span>{byline(a)}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  {shelf.length > 0 && (
    <section class="wrap shelf" aria-labelledby="shelf-head">
      <div class="section-label"><h2 id="shelf-head">Print editions</h2><a class="more-link" href={href('/issues/')}>All issues</a></div>
      <div class="shelf-grid">
        {shelf.map((issue) => {
          const c = picture(issue.data.pageImages[0]);
          return (
            <a class="issue-card" href={href(`/issues/${issue.id}/`)}>
              <span class="cover">{c && <img src={c.src} srcset={c.srcset} sizes="220px" width={c.width} height={c.height} alt="" loading="lazy" decoding="async" />}</span>
              <span><h3>{issue.data.title}</h3><span class="meta">{issue.data.dateLabel ?? issue.data.year}</span></span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="wrap join" aria-labelledby="join-head">
    <h2 id="join-head">Write for The Governor</h2>
    <p>The paper is made by students, for the whole Academy. Pitch a story, send a tip, or write a letter to the editors.</p>
    <div class="actions">
      <a class="button" href={href('/join/')}>Join the staff</a>
      <a class="button ghost" href={href('/contact/')}>Submit a tip or letter</a>
    </div>
  </section>
</BaseLayout>
