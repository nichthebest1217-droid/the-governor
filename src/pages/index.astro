---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import SectionBand from '../components/SectionBand.astro';
import homepage from '../data/homepage.json';
import { SECTIONS, SITE, type Article, dayOf, formatDate, getArticles, href, permalink, picture, refId } from '../lib/site';

// Front page, in the order the masterplan sets out:
//   lead package -> latest -> editors' picks -> one band per section -> print issue -> join.
const all = await getArticles();
const issues = await getCollection('issues');
const issueById = new Map(issues.map((i) => [i.id, i]));
const byId = new Map(all.map((a) => [a.id, a]));
const pick = (refs: (string | null)[] | null | undefined) => (refs ?? []).map((r) => byId.get(refId(r))).filter((a): a is Article => Boolean(a));

// The newest edition: a print issue once three of its articles are online, else the latest day.
const perIssue = new Map<string, number>();
for (const a of all) if (a.data.issueId) perIssue.set(a.data.issueId, (perIssue.get(a.data.issueId) ?? 0) + 1);
const first = all[0];
const editionIssue = first?.data.issueId && (perIssue.get(first.data.issueId) ?? 0) >= 3 ? issueById.get(first.data.issueId) : undefined;
const edition = !first ? [] : editionIssue
  ? all.filter((a) => a.data.issueId === editionIssue.id).sort((a, b) => (a.data.printOrder ?? 999) - (b.data.printOrder ?? 999))
  : all.filter((a) => dayOf(a.data.publishedAt) === dayOf(first.data.publishedAt));
// Top of the page draws on the newest edition first, then on everything else by date.
const pool = [...edition, ...all.filter((a) => !edition.includes(a))];

const used = new Set<Article>();
const take = (list: Article[], n: number) => { const out = list.filter((a) => !used.has(a)).slice(0, n); out.forEach((a) => used.add(a)); return out; };
const ratio = (a: Article) => { const p = picture(a.data.coverImage); return p?.width && p.height ? p.width / p.height : 0; };

// Lead: the editors' pick, else a story marked "featured", else the first with a landscape photo.
const lead = pick([homepage.lead])[0] ?? pool.find((a) => a.data.featured && a.data.coverImage) ?? pool.find((a) => ratio(a) >= 1.4) ?? pool.find((a) => a.data.coverImage) ?? pool[0];
if (lead) used.add(lead);
const chosen = pick(homepage.secondary);
const rail = take([...chosen, ...pool], 4);
const latest = take(pool, 4);
const picks = pick(homepage.editorsPicks).filter((a) => !used.has(a)).slice(0, 4);
picks.forEach((a) => used.add(a));

// Section bands prefer stories not already shown above, but a thin section is topped up with
// its own latest stories rather than left half empty.
const bands = SECTIONS.map((s) => {
  const mine = all.filter((a) => a !== lead && (a.data.section === s.slug || a.data.secondarySections.includes(s.slug as never)));
  const fresh = mine.filter((a) => !used.has(a));
  const list = [...fresh, ...mine.filter((a) => used.has(a))].slice(0, 4);
  return { ...s, articles: list };
}).filter((b) => b.articles.length > 0);

const promoted = homepage.currentIssue ? await getEntry('issues', refId(homepage.currentIssue)) : editionIssue;
const promotedCover = promoted ? picture(promoted.data.pageImages[0]) : null;
const otherIssues = issues.filter((i) => i.id !== promoted?.id && i.data.pageImages.length > 0);
const leadPic = lead ? picture(lead.data.coverImage) : null;
---
<BaseLayout>
  <h1 class="visually-hidden">{SITE.name}</h1>
  {!lead && <div class="wrap band"><p>No articles have been published yet.</p></div>}

  {lead && (
    <div class="wrap">
      {(editionIssue || first) && (
        <p class="issue-strip">
          <strong>{editionIssue ? editionIssue.data.title : 'Latest'}</strong>
          <span>{editionIssue?.data.dateLabel ?? formatDate(first.data.publishedAt)}</span>
          {editionIssue && <a href={href(`/issues/${editionIssue.id}/`)}>Read the print edition</a>}
        </p>
      )}

      <section class="package" aria-label="Top stories">
        <article class="hero">
          {leadPic && (
            <a class="hero-photo zoom" href={href(permalink(lead))} tabindex="-1" aria-hidden="true">
              <img src={leadPic.src} srcset={leadPic.srcset} sizes="(min-width: 1024px) 720px, 100vw" width={leadPic.width} height={leadPic.height} alt="" fetchpriority="high" decoding="async" />
            </a>
          )}
          <StoryCard article={lead} size="lead" image={false} heading="h2" dekLength={300} />
        </article>
        <div class="rail">
          {rail.map((a) => <StoryCard article={a} size="medium" layout="row" heading="h2" dekLength={200} sizes="(min-width: 700px) 160px, 110px" />)}
        </div>
      </section>

      {latest.length > 0 && (
        <section class="band" aria-labelledby="latest-head">
          <div class="band-head"><h2 id="latest-head">Latest</h2><a class="more-link" href={href('/archives/')}>All articles</a></div>
          <div class="row-4">
            {latest.map((a) => <StoryCard article={a} size="small" image={false} dekLength={190} />)}
          </div>
        </section>
      )}
    </div>
  )}

  {picks.length > 0 && (
    <section class="picks" aria-labelledby="picks-head">
      <div class="wrap">
        <div class="band-head"><h2 id="picks-head">Editors’ Picks</h2></div>
        <div class="row-4 uniform">
          {picks.map((a) => <StoryCard article={a} size="small" dekLength={150} sizes="(min-width: 1024px) 290px, 50vw" />)}
        </div>
      </div>
    </section>
  )}

  {bands.map((b, i) => <SectionBand slug={b.slug} label={b.label} articles={b.articles} reverse={i % 2 === 1} />)}

  {promoted && (promoted.data.pdf || promotedCover) && (
    <section class="wrap band" aria-labelledby="issue-head">
      <div class="print-callout">
        {promotedCover && (
          <a class="page" href={href(`/issues/${promoted.id}/`)} tabindex="-1" aria-hidden="true">
            <img src={promotedCover.src} srcset={promotedCover.srcset} sizes="220px" width={promotedCover.width} height={promotedCover.height} alt="" loading="lazy" decoding="async" />
          </a>
        )}
        <div class="print-text">
          <span class="kicker">In print</span>
          <h2 id="issue-head">{promoted.data.title}{promoted.data.dateLabel && <em>, {promoted.data.dateLabel}</em>}</h2>
          <p>Read the paper as it was laid out for campus, page by page, or download the full edition.</p>
          <div class="actions">
            <a class="button" href={href(`/issues/${promoted.id}/`)}>Read the issue</a>
            {promoted.data.pdf && <a class="button ghost" href={href(promoted.data.pdf)}>Download PDF</a>}
            <a class="button ghost" href={href('/issues/')}>All print issues</a>
          </div>
        </div>
        {otherIssues.length > 0 && (
          <div class="print-shelf">
            <span class="kicker" style="color:var(--ink-soft)">Earlier editions</span>
            <div class="shelf-row">
              {otherIssues.slice(0, 3).map((issue) => {
                const c = picture(issue.data.pageImages[0]);
                return (
                  <a class="issue-card" href={href(`/issues/${issue.id}/`)}>
                    <span class="cover">{c && <img src={c.src} srcset={c.srcset} sizes="150px" width={c.width} height={c.height} alt="" loading="lazy" decoding="async" />}</span>
                    <span><h3>{issue.data.title}</h3><span class="meta">{issue.data.dateLabel ?? issue.data.year}</span></span>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="join" aria-labelledby="join-head">
    <div class="wrap join-inner">
      <div>
        <h2 id="join-head">Write for The Governor</h2>
        <p>The paper is made by students, for the whole Academy. Pitch a story, send a tip, or write a letter to the editors.</p>
      </div>
      <div class="actions">
        <a class="button" href={href('/join/')}>Join the staff</a>
        <a class="button ghost" href={href('/contact/')}>Submit a tip or letter</a>
      </div>
    </div>
  </section>
</BaseLayout>
