---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import AlignedRows from '../components/AlignedRows.astro';
import homepage from '../data/homepage.json';
import { SITE, type Article, type Issue, dayOf, formatDate, getArticles, href, picture, refId } from '../lib/site';

// The front page is a timeline. The newest edition sits at the top; scrolling down goes back
// in time. Articles are grouped by print issue when the issue is documented, otherwise by the
// day they were published.
const all = await getArticles();
const issues = new Map((await getCollection('issues')).map((i) => [i.id, i]));
const perIssue = new Map<string, number>();
for (const a of all) if (a.data.issueId) perIssue.set(a.data.issueId, (perIssue.get(a.data.issueId) ?? 0) + 1);

interface Group { key: string; issue?: Issue; day: string; articles: Article[] }
const groups = new Map<string, Group>();
for (const a of all) {
  // An issue gets its own block once at least three of its articles are online.
  const issue = a.data.issueId && (perIssue.get(a.data.issueId) ?? 0) >= 3 ? issues.get(a.data.issueId) : undefined;
  const key = issue ? `issue:${issue.id}` : `day:${dayOf(a.data.publishedAt)}`;
  const g = groups.get(key) ?? { key, issue, day: dayOf(a.data.publishedAt), articles: [] };
  g.articles.push(a);
  if (dayOf(a.data.publishedAt) > g.day) g.day = dayOf(a.data.publishedAt);
  groups.set(key, g);
}
const timeline = [...groups.values()].sort((x, y) => y.day.localeCompare(x.day));
for (const g of timeline) {
  // Inside an issue, follow the paper's own running order (front page first).
  if (g.issue) g.articles.sort((a, b) => (a.data.printOrder ?? 999) - (b.data.printOrder ?? 999));
}

const [newest, ...older] = timeline;
const byId = new Map(all.map((a) => [a.id, a]));
// Newest edition: a composed front page. Modules differ in width, picture placement and
// headline size, and every photograph keeps its own shape (upright pictures stay upright).
const shapeOf = (a: Article) => { const p = picture(a.data.coverImage); const r = p?.width && p.height ? p.width / p.height : 1.5; return r < 0.95 ? 'tall' : 'wide'; };
// A proper landscape picture (not a near-square portrait, not a thin strip) suits the lead spot.
const landscape = (a: Article) => { const p = picture(a.data.coverImage); const r = p?.width && p.height ? p.width / p.height : 0; return r >= 1.4 && r <= 1.9; };
interface Band { beside?: Article; stack?: Article; text: Article[]; flip: boolean }
let lead: Article | undefined, topLeft: Article[] = [], topRight: { photo?: Article; text: Article[] } = { text: [] }, bands: Band[] = [], overflow: Article[] = [];
if (newest) {
  const pool = [...newest.articles];
  const chosen = byId.get(refId(homepage.lead));
  // Lead: the editors' pick, else a story marked "featured", else the first story with a wide photo.
  lead = (chosen && pool.includes(chosen) ? chosen : undefined) ?? pool.find((a) => a.data.featured && a.data.coverImage) ?? pool.find(landscape) ?? pool.find((a) => a.data.coverImage && shapeOf(a) === 'wide') ?? pool.find((a) => a.data.coverImage) ?? pool[0];
  const photos = pool.filter((a) => a !== lead && a.data.coverImage);
  const texts = pool.filter((a) => a !== lead && !a.data.coverImage);
  const takePhoto = (prefer: 'tall' | 'wide') => { const i = Math.max(0, photos.findIndex((a) => shapeOf(a) === prefer)); return photos.splice(i, 1)[0]; };
  topRight = { photo: takePhoto('tall'), text: [] };
  topLeft = texts.splice(0, topRight.photo ? 3 : 2);
  topRight.text = texts.splice(0, topRight.photo ? 1 : 3);
  while (photos.length > 0 && bands.length < 4) {
    const flip = bands.length % 2 === 1;
    const beside = takePhoto('tall');
    const stack = photos.length ? takePhoto('wide') : undefined;
    bands.push({ beside, stack, text: texts.splice(0, 2), flip });
  }
  overflow = [...photos, ...texts];
}
const heading = (g: Group) => (g.issue ? g.issue.data.title : formatDate(g.day));
const subheading = (g: Group) => (g.issue ? g.issue.data.dateLabel ?? `${g.issue.data.season ?? ''} ${g.issue.data.year}`.trim() : null);
---
<BaseLayout>
  <h1 class="visually-hidden">{SITE.name}</h1>
  {!newest && <div class="wrap band"><p>No articles have been published yet.</p></div>}

  {newest && (
    <section class="wrap edition is-newest" aria-labelledby="edition-0">
      <header class="edition-head">
        <div>
          <span class="kicker">{newest.issue ? 'Latest issue' : 'Latest'}</span>
          <h2 id="edition-0">{heading(newest)}{subheading(newest) && <span class="when">{subheading(newest)}</span>}</h2>
        </div>
        {newest.issue && (
          <p class="edition-links">
            <a href={href(`/issues/${newest.issue.id}/`)}>Read the print edition</a>
            {newest.issue.data.pdf && <a href={href(newest.issue.data.pdf)}>PDF</a>}
          </p>
        )}
      </header>
      {lead && (
        <div class="mosaic mosaic-top">
          <div class="cell cell-3">
            {topLeft.map((a, i) => <StoryCard article={a} size={i === 0 ? 'medium' : 'small'} image={false} heading="h3" dekLength={i === 0 ? 300 : 160} />)}
          </div>
          <div class="cell cell-6 cell-lead">
            <StoryCard article={lead} size="lead" heading="h3" eager dekLength={260} sizes="(min-width: 1024px) 600px, 100vw" />
          </div>
          <div class="cell cell-3">
            {topRight.photo && <StoryCard article={topRight.photo} size="medium" heading="h3" dek={false} sizes="(min-width: 1024px) 290px, (min-width: 768px) 40vw, 100vw" />}
            {topRight.text.map((a) => <StoryCard article={a} size="small" image={false} heading="h3" dekLength={170} />)}
          </div>
        </div>
      )}
      {bands.map((band) => (
        <div class:list={['mosaic', 'mosaic-band', { flip: band.flip }]}>
          {band.beside && (
            <div class="cell cell-5 cell-beside">
              <StoryCard article={band.beside} size="large" layout="row" mediaSide={band.flip ? 'right' : 'left'} heading="h3" dekLength={300} sizes="(min-width: 768px) 230px, 45vw" />
            </div>
          )}
          {band.stack && (
            <div class:list={['cell', band.text.length ? 'cell-4' : 'cell-7']}>
              <StoryCard article={band.stack} size="medium" heading="h3" dekLength={200} sizes="(min-width: 1024px) 400px, 100vw" />
            </div>
          )}
          {band.text.length > 0 && (
            <div class:list={['cell', band.stack ? 'cell-3' : 'cell-7']}>
              {band.text.map((a) => <StoryCard article={a} size="small" image={false} heading="h3" dekLength={150} />)}
            </div>
          )}
        </div>
      ))}
      <AlignedRows articles={overflow} max={4} />
    </section>
  )}

  {older.map((g, i) => {
    const photos = g.articles.filter((a) => a.data.coverImage);
    const text = g.articles.filter((a) => !a.data.coverImage);
    return (
      <section class="wrap edition" aria-labelledby={`edition-${i + 1}`}>
        <header class="edition-head">
          <div>
            <span class="kicker">{g.issue ? 'Print issue' : 'Published'}</span>
            <h2 id={`edition-${i + 1}`}>{heading(g)}{subheading(g) && <span class="when">{subheading(g)}</span>}</h2>
          </div>
          <p class="edition-links">
            {g.issue && <a href={href(`/issues/${g.issue.id}/`)}>Read the print edition</a>}
            <span>{g.articles.length} {g.articles.length === 1 ? 'article' : 'articles'}</span>
          </p>
        </header>
        <AlignedRows articles={photos} image max={4} offset={i} />
        <AlignedRows articles={text} max={4} offset={i + 1} />
      </section>
    );
  })}

  <section class="wrap join" aria-labelledby="join-head">
    <h2 id="join-head">Write for The Governor</h2>
    <p>The paper is made by students, for the whole Academy. Pitch a story, send a tip, or write a letter to the editors.</p>
    <div class="actions">
      <a class="button" href={href('/join/')}>Join the staff</a>
      <a class="button ghost" href={href('/contact/')}>Submit a tip or letter</a>
      <a class="button ghost" href={href('/archives/')}>Browse the full archive</a>
    </div>
  </section>
</BaseLayout>
