---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import Band from '../components/Band.astro';
import homepage from '../data/homepage.json';
import { SECTIONS, SITE, type Article, type Issue, academicYear, dayOf, formatDate, getArticles, href, permalink, picture, refId } from '../lib/site';

// The front page is a timeline. The newest edition sits at the top; scrolling down goes back
// in time. Articles are grouped by print issue when the issue is documented, otherwise by the
// day they were published.
const all = await getArticles();
const issues = new Map((await getCollection('issues')).map((i) => [i.id, i]));
const perIssue = new Map<string, number>();
for (const a of all) if (a.data.issueId) perIssue.set(a.data.issueId, (perIssue.get(a.data.issueId) ?? 0) + 1);

interface Group { key: string; issue?: Issue; day: string; articles: Article[] }
const groups = new Map<string, Group>();
for (const a of all) {
  // An issue gets its own block once at least three of its articles are online.
  const issue = a.data.issueId && (perIssue.get(a.data.issueId) ?? 0) >= 3 ? issues.get(a.data.issueId) : undefined;
  const key = issue ? `issue:${issue.id}` : `day:${dayOf(a.data.publishedAt)}`;
  const g = groups.get(key) ?? { key, issue, day: dayOf(a.data.publishedAt), articles: [] };
  g.articles.push(a);
  if (dayOf(a.data.publishedAt) > g.day) g.day = dayOf(a.data.publishedAt);
  groups.set(key, g);
}
const timeline = [...groups.values()].sort((x, y) => y.day.localeCompare(x.day));
for (const g of timeline) {
  // Inside an issue, follow the paper's own running order (front page first).
  if (g.issue) g.articles.sort((a, b) => (a.data.printOrder ?? 999) - (b.data.printOrder ?? 999));
}

const [newest, ...older] = timeline;
const byId = new Map(all.map((a) => [a.id, a]));
// Newest edition: a lead package, then one band per section, as on a newspaper front.
let lead: Article | undefined, second: Article[] = [], also: Article[] = [];
let sectionBands: { slug: string | null; label: string; articles: Article[] }[] = [];
if (newest) {
  const pool = [...newest.articles];
  const chosen = byId.get(refId(homepage.lead));
  const landscape = (a: Article) => { const p = picture(a.data.coverImage); const r = p?.width && p.height ? p.width / p.height : 0; return r >= 1.4; };
  // Lead: the editors' pick, else a story marked "featured", else the first story with a landscape photo.
  lead = (chosen && pool.includes(chosen) ? chosen : undefined) ?? pool.find((a) => a.data.featured && a.data.coverImage) ?? pool.find(landscape) ?? pool.find((a) => a.data.coverImage) ?? pool[0];
  const rest = pool.filter((a) => a !== lead);
  const noPhoto = rest.filter((a) => !a.data.coverImage);
  second = noPhoto.slice(0, 1);
  also = noPhoto.slice(1, 3);
  const remaining = rest.filter((a) => !second.includes(a) && !also.includes(a));
  const leftovers: Article[] = [];
  for (const s of SECTIONS) {
    const list = remaining.filter((a) => a.data.section === s.slug);
    if (list.length >= 2) sectionBands.push({ slug: s.slug, label: s.label, articles: list });
    else leftovers.push(...list);
  }
  if (leftovers.length) sectionBands.push({ slug: null, label: 'More from this issue', articles: leftovers });
}
const leadPic = lead ? picture(lead.data.coverImage) : null;
const heading = (g: Group) => (g.issue ? g.issue.data.title : formatDate(g.day));
const subheading = (g: Group) => (g.issue ? g.issue.data.dateLabel ?? `${g.issue.data.season ?? ''} ${g.issue.data.year}`.trim() : null);
---
<BaseLayout>
  <h1 class="visually-hidden">{SITE.name}</h1>
  {!newest && <div class="wrap band"><p>No articles have been published yet.</p></div>}

  {newest && lead && (
    <section class="wrap edition is-newest" aria-labelledby="edition-0">
      <header class="edition-head">
        <div>
          <span class="kicker">{newest.issue ? 'Latest issue' : 'Latest'}</span>
          <h2 id="edition-0">{heading(newest)}{subheading(newest) && <span class="when">{subheading(newest)}</span>}</h2>
        </div>
        {newest.issue && (
          <p class="edition-links">
            <a href={href(`/issues/${newest.issue.id}/`)}>Read the print edition</a>
            {newest.issue.data.pdf && <a href={href(newest.issue.data.pdf)}>PDF</a>}
          </p>
        )}
      </header>
      <div class:list={['top', { 'no-photo': !leadPic }]}>
        <div class="top-text">
          <StoryCard article={lead} size="lead" image={false} heading="h3" dekLength={520} />
          {second.map((a) => <StoryCard article={a} size="medium" image={false} heading="h3" dekLength={300} />)}
        </div>
        {leadPic && (
          <figure class="top-photo">
            <a href={href(permalink(lead))} tabindex="-1" aria-hidden="true">
              <img src={leadPic.src} srcset={leadPic.srcset} sizes="(min-width: 1024px) 720px, 100vw" width={leadPic.width} height={leadPic.height} alt="" fetchpriority="high" decoding="async" />
            </a>
            {(lead.data.coverCaption || lead.data.coverCredit) && <figcaption>{lead.data.coverCaption} {lead.data.coverCredit && <span class="credit">{lead.data.coverCredit}</span>}</figcaption>}
          </figure>
        )}
        {also.length > 0 && (
          <aside class="top-also" aria-labelledby="also-head">
            <h3 class="also-head" id="also-head">Also in this issue</h3>
            {also.map((a) => <StoryCard article={a} size="medium" image={false} heading="h4" dekLength={220} />)}
          </aside>
        )}
      </div>
      {sectionBands.map((b) => (
        <div class:list={['section-band', { 'one-section': b.slug }]}>
          <div class="section-band-head">
            <h3>{b.slug ? <a href={href(`/${b.slug}/`)}>{b.label}</a> : b.label}</h3>
            {b.slug && <a class="view-more" href={href(`/${b.slug}/`)} aria-label={`View more ${b.label}`}>View more</a>}
          </div>
          <Band articles={b.articles} listLimit={4} />
        </div>
      ))}
    </section>
  )}

  {older.map((g, i) => (
    <section class="wrap edition" aria-labelledby={`edition-${i + 1}`}>
      <header class="edition-head">
        <div>
          <span class="kicker">{g.issue ? 'Print issue' : 'Published'}</span>
          <h2 id={`edition-${i + 1}`}>{heading(g)}{subheading(g) && <span class="when">{subheading(g)}</span>}</h2>
        </div>
        <p class="edition-links">
          {g.issue && <a href={href(`/issues/${g.issue.id}/`)}>Read the print edition</a>}
          {g.articles.length > 4 && <a href={href(g.issue ? `/issues/${g.issue.id}/` : `/archives/${academicYear(g.day)}/`)}>All {g.articles.length} articles</a>}
        </p>
      </header>
      <div class="section-band"><Band articles={g.articles} listLimit={3} /></div>
    </section>
  ))}

  <section class="wrap join" aria-labelledby="join-head">
    <h2 id="join-head">Write for The Governor</h2>
    <p>The paper is made by students, for the whole Academy. Pitch a story, send a tip, or write a letter to the editors.</p>
    <div class="actions">
      <a class="button" href={href('/join/')}>Join the staff</a>
      <a class="button ghost" href={href('/contact/')}>Submit a tip or letter</a>
      <a class="button ghost" href={href('/archives/')}>Browse the full archive</a>
    </div>
  </section>
</BaseLayout>
