---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
---
<BaseLayout title="Search" description="Search every article in The Governor's archive." noindex>
  <link slot="head" rel="stylesheet" href={href('/pagefind/pagefind-ui.css')} />
  <div class="wrap">
    <header class="page-head"><span class="kicker">Archives</span><h1>Search</h1><p>Full text of every published article, by headline, writer or phrase.</p></header>
    <div class="search-shell" id="search" data-bundle={href('/pagefind/')}></div>
    <noscript><p class="note">Search needs JavaScript. You can still browse the <a href={href('/archives/')}>archive by date</a>.</p></noscript>
    <p class="note" id="search-missing" hidden>The search index is built when the site is published (<code>npm run build</code>), so it is not available in the live development server. Use <code>npm run preview</code> to try it.</p>
  </div>
  <script is:inline>
    (() => {
      const el = document.getElementById('search');
      const s = document.createElement('script');
      s.src = el.dataset.bundle + 'pagefind-ui.js';
      s.onload = () => {
        const ui = new PagefindUI({ element: '#search', bundlePath: el.dataset.bundle, showSubResults: false, showImages: false, resetStyles: false, autofocus: true, translations: { placeholder: 'Search The Governor' } });
        const q = new URLSearchParams(location.search).get('q');
        if (q) ui.triggerSearch(q);
      };
      s.onerror = () => { document.getElementById('search-missing').hidden = false; };
      document.head.appendChild(s);
    })();
  </script>
</BaseLayout>
