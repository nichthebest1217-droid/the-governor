---
// One calm, repeatable block: a photo story on the left, a list of stories on the right.
// With no photo story the list simply runs in two columns.
import StoryCard from './StoryCard.astro';
import { type Article, picture } from '../lib/site';

interface Props { articles: Article[]; listLimit?: number }
const { articles, listLimit = 3 } = Astro.props;
const feature = articles.find((a) => a.data.coverImage);
const list = articles.filter((a) => a !== feature).slice(0, feature ? listLimit : listLimit + 1);
const shape = (a: Article) => { const p = picture(a.data.coverImage); return p?.width && p.height && p.width / p.height < 0.95 ? 'tall' : 'wide'; };
---
<div class:list={['band-grid', { 'no-feature': !feature, 'solo': list.length === 0 }]}>
  {feature && (
    <div class="band-feature">
      {shape(feature) === 'tall'
        ? <StoryCard article={feature} size="large" layout="row" mediaSide="left" dekLength={520} sizes="(min-width: 768px) 280px, 40vw" />
        : <StoryCard article={feature} size="large" dekLength={420} sizes="(min-width: 1024px) 640px, 100vw" />}
    </div>
  )}
  {list.length > 0 && (
    <div class:list={['band-list', `count-${Math.min(list.length, 3)}`]}>
      {list.map((a) => <StoryCard article={a} size="medium" layout="row" dekLength={list.length === 1 ? 1100 : list.length === 2 ? 760 : 460} sizes="(min-width: 768px) 230px, 110px" />)}
    </div>
  )}
</div>
