---
interface Props { name: 'search' | 'menu' | 'close' }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false" class={`icon-${name}`}>
  {name === 'search' && <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></>}
  {name === 'menu' && <path d="M3 6h18M3 12h18M3 18h18" />}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
</svg>
