---
// Lays stories out in full rows: no row ever ends with an empty cell, every card in a row is
// the same height, and bylines sit on a common baseline.
import StoryCard from './StoryCard.astro';
import type { Article } from '../lib/site';

interface Props { articles: Article[]; image?: boolean; max?: number; size?: 'medium' | 'small'; dek?: boolean; offset?: number }
const { articles, image = false, max = 4, size = 'medium', dek = true, offset = 0 } = Astro.props;

/** Split n cards into rows of nearly equal size (never a lonely last card when avoidable). */
function rowSizes(n: number): number[] {
  if (n <= max) return n ? [n] : [];
  const rows = Math.ceil(n / max);
  const base = Math.floor(n / rows);
  return Array.from({ length: rows }, (_, i) => base + (i < n % rows ? 1 : 0));
}
// Column widths rotate from row to row so the page does not read as a uniform grid.
const TEMPLATES: Record<number, string[]> = {
  1: ['1fr'],
  2: ['7fr 5fr', '5fr 7fr'],
  3: ['5fr 4fr 3fr', '3fr 4fr 5fr', '4fr 5fr 3fr', '3fr 5fr 4fr'],
  4: ['4fr 3fr 3fr 2fr', '2fr 3fr 3fr 4fr', '3fr 4fr 2fr 3fr', '3fr 2fr 4fr 3fr'],
};
const widest = (t: string) => { const w = t.split(' ').map((x) => parseFloat(x)); return w.indexOf(Math.max(...w)); };
let cursor = 0;
const rows = rowSizes(articles.length).map((count) => articles.slice(cursor, (cursor += count)));
---
{rows.map((row, r) => {
  const list = TEMPLATES[row.length] ?? [`repeat(${row.length}, 1fr)`];
  const template = list[(r + offset) % list.length];
  const big = row.length > 1 ? widest(template) : -1;
  return (
    <div class="aligned-row" style={`--template:${template}`}>
      {row.map((a, i) => (
        <StoryCard article={a} size={i === big ? 'large' : size} image={image} dek={dek || i === big} dekLength={i === big ? 260 : 150}
          sizes="(min-width: 1024px) 420px, (min-width: 768px) 50vw, 100vw" />
      ))}
    </div>
  );
})}
